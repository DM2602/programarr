# Port of the web app
PROGRAMARR_PORT=8796

# Owner of the poster files (same as Plex and Sonarr/Radarr)
PUID=1000
PGID=1000
UMASK=002
TZ=Europe/Zurich

# Media folders on the host, mounted as /media
MEDIA_PATH=/mnt/media

# Optional password for the web app. Empty = no sign-in (home network or behind Pangolin SSO).
APP_PASSWORD=

# DEBUG while troubleshooting
PROGRAMARR_LOG_LEVEL=INFO
